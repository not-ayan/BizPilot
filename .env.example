# Database configuration
DATABASE_URL=postgresql://postgres:postgres@db:5432/bizpilot

# WhatsApp Business Cloud API settings
WHATSAPP_TOKEN=your_whatsapp_permanent_access_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token_here
WHATSAPP_API_VERSION=v19.0

# Google Sheets catalogue integration
GOOGLE_SHEETS_CREDENTIALS_FILE=credentials.json
GOOGLE_SHEET_URL=https://docs.google.com/spreadsheets/d/your_spreadsheet_id/edit
GOOGLE_SHEETS_API_SECRET=your_shared_secret_passcode_here

# System Configurations
PRIMARY_ADMIN_PHONE=9876543210
SECRET_KEY=generate_a_secure_secret_key_here
PORT=8000

# PDF Invoicing
PDF_OUTPUT_DIR=invoices

# Google Gemini API (AI Broadcast Marketing)
GEMINI_API_KEY=your_gemini_api_key_here
